{
	"name": "cosmic-esbuild",
	"version": "0.7.3",
	"description": "esbuild meets cosmiconfig, write your configs like you're used to",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/cosmic-esbuild.git"
	},
	"keywords": [
		"esbuild",
		"esbuild-config",
		"cosmiconfig"
	],
	"type": "module",
	"bin": {
		"cosmic-esbuild": "./lib/cli.mjs"
	},
	"exports": {
		"types": {
			"import": "./lib/config.d.mts",
			"require": "./lib/config.d.cts"
		},
		"import": "./lib/config.mjs",
		"require": "./lib/config.cjs"
	},
	"main": "./lib/config.cjs",
	"types": "./lib/config.d.cts",
	"engines": {
		"node": ">=20.0.0"
	},
	"files": [
		"lib/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^14.0.3",
		"confbox": "^0.2.4",
		"consola": "^3.4.2",
		"cosmiconfig": "^9.0.1",
		"cosmiconfig-typescript-loader": "^6.3.0",
		"cson-parser": "^4.0.9"
	},
	"devDependencies": {
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@idleberg/configs": "^0.4.2",
		"@types/node": "^24.12.2",
		"@vitest/coverage-v8": "^4.1.5",
		"concurrently": "^9.2.1",
		"np": "^11.2.0",
		"tsdown": "^0.21.10",
		"typescript": "^6.0.3",
		"vitest": "^4.1.5"
	},
	"peerDependencies": {
		"esbuild": ">=0.25"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800"
}
