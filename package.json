{
	"name": "cosmic-esbuild",
	"version": "0.7.3",
	"description": "esbuild meets cosmiconfig, write your configs like you're used to",
	"license": "MIT",
	"author": "Jan T. Sott",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/idleberg/cosmic-esbuild.git"
	},
	"keywords": [
		"esbuild",
		"esbuild-config",
		"cosmiconfig"
	],
	"type": "module",
	"bin": {
		"cosmic-esbuild": "./lib/cli.mjs"
	},
	"exports": {
		"types": {
			"import": "./lib/config.d.mts",
			"require": "./lib/config.d.cts"
		},
		"import": "./lib/config.mjs",
		"require": "./lib/config.cjs"
	},
	"main": "./lib/config.cjs",
	"types": "./lib/config.d.cts",
	"engines": {
		"node": ">=22.21.0"
	},
	"files": [
		"lib/",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"lint": "concurrently --prefix-colors blue,green,magenta npm:lint:*",
		"lint:biome": "biome check",
		"lint:e18e": "e18e-cli analyze --log-level error",
		"prepack": "npm run build",
		"publish:jsr": "deno publish",
		"publish:npm": "np",
		"test": "vitest run"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"confbox": "^0.2.4",
		"consola": "^3.4.2",
		"cosmiconfig": "^10.0.0",
		"cosmiconfig-typescript-loader": "^6.3.0",
		"cson-parser": "^4.0.9"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@idleberg/configs": "^0.4.6",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.10",
		"concurrently": "^10.0.4",
		"np": "^12.0.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"peerDependencies": {
		"esbuild": ">=0.25"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"lefthook"
		]
	},
	"packageManager": "pnpm@11.19.0+sha512.7881f3ed590d472c4a955e2b88b2121791116066dcc88cbca3849ec9b60f1bbaa6d2ccb221fa91da4e1c65bef2bcbe379365aea7ac539c7bf86dedc3a1b22dce"
}
